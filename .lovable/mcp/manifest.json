{
  "version": 1,
  "sdk_version": "1.0.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rhzmhiknbcipucfvgkok.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "360",
      "version": "0.1.0",
      "title": "תפעול 360"
    },
    "tools": [
      {
        "name": "list_employees",
        "title": "List employees",
        "description": "List employees the signed-in user may see, optionally filtered by name/code search, status or department.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Free text matched against full name or employee code.",
              "type": "string"
            },
            "status": {
              "description": "Employee status filter.",
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "offboarding"
              ]
            },
            "department": {
              "description": "Exact department name.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_employee",
        "title": "Get employee details",
        "description": "Fetch one employee card with the assets currently assigned to them. Accepts an employee id or employee code.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "employee_id": {
              "description": "Employee UUID.",
              "type": "string"
            },
            "employee_code": {
              "description": "Employee code, e.g. EMP-1042.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_assets",
        "title": "List assets",
        "description": "List company resources (equipment, vehicles, digital access, licenses) with optional search, status filter and assignment filter.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Free text matched against asset name, code, serial number or license plate.",
              "type": "string"
            },
            "status": {
              "description": "Asset status value, e.g. available, assigned, maintenance.",
              "type": "string"
            },
            "unassigned_only": {
              "description": "Return only assets with no current owner.",
              "type": "boolean"
            },
            "owner_employee_id": {
              "description": "Return only assets held by this employee UUID.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_leave_requests",
        "title": "List leave and sickness requests",
        "description": "List leave, sickness and reserve-duty requests, optionally filtered by employee, status, type or date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "employee_id": {
              "description": "Filter by employee UUID.",
              "type": "string"
            },
            "status": {
              "description": "Request status, e.g. approved, pending, rejected.",
              "type": "string"
            },
            "request_type": {
              "description": "Request type, e.g. vacation, sick, reserve.",
              "type": "string"
            },
            "from_date": {
              "description": "Only requests starting on or after this ISO date (YYYY-MM-DD).",
              "type": "string"
            },
            "to_date": {
              "description": "Only requests starting on or before this ISO date (YYYY-MM-DD).",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_it_tickets",
        "title": "List IT tickets",
        "description": "List IT/operations tickets, optionally filtered by status, priority or employee.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Ticket status, e.g. open, in_progress, resolved.",
              "type": "string"
            },
            "priority": {
              "description": "Ticket priority, e.g. low, medium, high, urgent.",
              "type": "string"
            },
            "employee_id": {
              "description": "Filter by requesting employee UUID.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 25, max 100).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_it_ticket",
        "title": "Create IT ticket",
        "description": "Open a new IT/operations ticket for an employee in תפעול 360.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "employee_id": {
              "type": "string",
              "description": "UUID of the employee the ticket is opened for."
            },
            "title": {
              "type": "string",
              "description": "Short ticket title in Hebrew or English."
            },
            "ticket_type": {
              "description": "Ticket type, e.g. hardware, software, access.",
              "type": "string"
            },
            "priority": {
              "description": "Priority: low, medium, high or urgent. Defaults to medium.",
              "type": "string"
            }
          },
          "required": [
            "employee_id",
            "title"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
